{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "gradle",
            "label": "Architectury: fabric Client",
            "id": "fabric:runClient",
            "description": "Run Minecraft (debug mode)",
            "script": "fabric:runClient",
            "group": "loom",
            "project": "fabric",
            "buildFile": "${workspaceFolder}/fabric/build.gradle",
            "rootProject": "GradleTemplate",
            "projectFolder": "${workspaceFolder}",
            "workspaceFolder": "${workspaceFolder}",
            "args": "--debug-jvm --console=plain",
            "javaDebug": false,
            "problemMatcher": {
                "base": "$gradle",
                "pattern": [
                    {
                        "regexp": "\\b\\B",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "^.*Listening for transport dt_socket at address.*"
                }
            },
            "isBackground": true
        },
