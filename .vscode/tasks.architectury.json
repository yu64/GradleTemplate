{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Architectury: fabric Client",
            "type": "shell",
            "command": "./gradlew",
            "windows": {
                "command": ".\\gradlew.bat"
            },
            "args": [
                ":fabric:runClient",
                "--debug-jvm",
                "--console=plain",
                "--no-daemon"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": [
                {
                    "owner": "architectury",
                    "pattern": {
                        "regexp": "^(?!)()$",
                        "message": 1,
                        "file": 1
                    },
                    "background": {
                        "endsPattern": "^.*Listening for transport dt_socket at address: 5005.*$",
                        "activeOnStart": true,
                        "beginsPattern": "^.*\u003e Task .*:run(Client|Server).*$"
                    }
                }
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
